# Local dev (no Docker/PostgreSQL available yet): SQLite file.
# Production target per the build plan: PostgreSQL — see PROJECT_CONTEXT.md.
DATABASE_URL="file:./dev.db"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Signs the login tokens. Anyone who knows this can forge a session for any
# user, so it must be a long random string and must NOT be committed.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="changez-moi-par-une-longue-chaine-aleatoire"
# How long a login lasts. 12h covers a full shift without spanning a night.
JWT_EXPIRES_IN="12h"
