// Harrix ERP — database schema.
//
// Local development uses SQLite (see datasource below) because this
// environment has no Docker/PostgreSQL available. The build plan's target
// for the factory PC is PostgreSQL. Switching later means: change
// `provider` to "postgresql", point DATABASE_URL at the real database, and
// re-run `npx prisma migrate dev`. Nothing in this schema uses a
// SQLite-only feature, so the switch is mechanical — see
// PROJECT_CONTEXT.md → "Backend" → "Moving to PostgreSQL" for the exact
// steps.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  // Prisma 7 moved the connection URL out of this file and into
  // prisma.config.ts (for the CLI) and the driver adapter (for the runtime
  // client, see src/prisma/prisma.service.ts). `provider` still lives here.
  provider = "sqlite"
}

/// The four (for now) inventories, stored as data rather than a fixed enum —
/// see build plan Phase 4: a future factory can have a different set without
/// a schema change.
model InventoryType {
  id               String  @id @default(cuid())
  /// Stable machine key used by the frontend and seed data, e.g. "chemicals".
  key              String  @unique
  label            String
  singular         String
  description      String
  hasBatches       Boolean @default(false)
  hasExpiry        Boolean @default(false)
  isProductionInput Boolean @default(false)
  /// Whether items in this inventory carry a colour / size variant (e.g. tige).
  hasColor         Boolean @default(false)
  hasSize          Boolean @default(false)
  /// Whether items carry a free-text description (e.g. spare parts).
  hasDescription   Boolean @default(false)
  /// Whether items carry maintenance-oriented machine info (machine,
  /// compatibility, manufacturer, location, criticality) and their usages
  /// record maintenance context (reference, employee, notes). Used by spare
  /// parts.
  hasMachineInfo   Boolean @default(false)
  /// Whether items carry a gender variant — "M"/"F". Used by finished goods.
  hasGender        Boolean @default(false)
  /// Whether items carry a sale price (in DZD). Used by finished goods.
  hasPrice         Boolean @default(false)
  /// Whether movements distinguish production quality ("1er"/"2ème"/"rebut").
  /// Used by finished goods — the classified buckets reconcile against the
  /// computed quantity to surface unaccounted units.
  hasQuality       Boolean @default(false)
  defaultUnit      String
  sortOrder        Int     @default(0)

  items Item[]
}

model Item {
  id                String   @id @default(cuid())
  inventoryType     InventoryType @relation(fields: [inventoryTypeId], references: [id])
  inventoryTypeId   String
  name              String
  reference         String   @unique
  unit              String
  reorderThreshold  Float
/// Optional photo — a URL (http/https) or a data-URI (inline image).
  photoUrl          String?
  /// Optional variant attributes (relevant for e.g. tige des chaussures).
  color             String?
  size              String?
  /// Optional free-text description (relevant for e.g. spare parts).
  description       String?
  /// Maintenance-oriented attributes (relevant for spare parts; gated in the
  /// UI by InventoryType.hasMachineInfo).
  machine           String?
  compatibility     String?
  manufacturer      String?
  location          String?
  criticality       String?
  /// Optional gender variant "M"/"F" (relevant for e.g. produced footwear;
  /// gated in the UI by InventoryType.hasGender).
  gender            String?
  /// Optional sale price in DZD (gated in the UI by InventoryType.hasPrice).
  price             Float?
  archived          Boolean @default(false)
  createdAt         DateTime @default(now())

  batches           Batch[]
  movements         Movement[]
  supplierOrderLines SupplierOrderLine[]

  @@index([inventoryTypeId])
}

/// Only used by items whose inventory type has hasBatches = true (chemicals).
/// A batch's remaining quantity is never stored directly — it is always the
/// sum of its movements, computed on read (see stock/stock.service.ts).
model Batch {
  id            String    @id @default(cuid())
  item          Item      @relation(fields: [itemId], references: [id])
  itemId        String
  batchNumber   String
  receivedDate  DateTime
  expiryDate    DateTime?

  movements Movement[]

  @@index([itemId])
}

/// The only place stock quantity comes from. An item's quantity is always
/// SUM(IN) - SUM(OUT) over its movements — never a column that gets edited
/// directly. This is deliberate (see build plan, "five calls that are cheap
/// today"): it is the only way to answer "how did we get to this number?".
model Movement {
  id         String    @id @default(cuid())
  item       Item      @relation(fields: [itemId], references: [id])
  itemId     String
  batch      Batch?    @relation(fields: [batchId], references: [id])
  batchId    String?
  /// "IN" | "OUT" — kept as a plain string (not a Prisma enum) so this schema
  /// is portable to SQLite and PostgreSQL without a provider-specific type.
  /// Validated at the API boundary (see stock/dto).
  direction  String
  quantity   Float
  date       DateTime
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?
  /// Only set on "OUT" movements (e.g. "Production", "Casse", "Périmé").
  reason     String?
  /// Maintenance context recorded on OUT usages of spare parts
  /// (gated in the UI by InventoryType.hasMachineInfo).
  machine        String?
  maintenanceRef String?
  employee       String?
  notes          String?
  /// Production character classification for finished goods
  /// (gated by InventoryType.hasQuality): "1er", "2ème" or "rebut".
  /// Movements left untagged are exactly what the reconciliation flags as
  /// unaccounted units — stock whose presence no production record explains.
  quality        String?
  createdAt  DateTime  @default(now())

  @@index([itemId])
  @@index([batchId])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  movements Movement[]
  supplierOrders SupplierOrder[]
}

/// A purchase order placed with a supplier. Stock only actually enters the
/// inventory when the order is received (see POST /supplier-orders/:id/receive,
/// which creates the IN movements and batch records). "regular inventory"
/// (tige, spare parts) has no expiry; chemicals orders carry per-line batch
/// info captured at receive time.
model SupplierOrder {
  id           String   @id @default(cuid())
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  supplierId   String
  orderDate    DateTime
  /// "open" | "received" — plain string, validated at the API boundary.
  status       String   @default("open")
  receivedDate DateTime?
  notes        String?
  createdAt    DateTime @default(now())

  lines SupplierOrderLine[]

  @@index([supplierId])
}

model SupplierOrderLine {
  id              String        @id @default(cuid())
  order           SupplierOrder @relation(fields: [orderId], references: [id])
  orderId         String
  item            Item          @relation(fields: [itemId], references: [id])
  itemId          String
  quantityOrdered Float
  /// Batch details captured when the order is received (chemicals only).
  batchNumber     String?
  expiryDate      DateTime?

  @@index([orderId])
}
