// Harrix ERP — database schema.
//
// Local development uses SQLite (see datasource below) because this
// environment has no Docker/PostgreSQL available. The build plan's target
// for the factory PC is PostgreSQL. Switching later means: change
// `provider` to "postgresql", point DATABASE_URL at the real database, and
// re-run `npx prisma migrate dev`. Nothing in this schema uses a
// SQLite-only feature, so the switch is mechanical — see
// PROJECT_CONTEXT.md → "Backend" → "Moving to PostgreSQL" for the exact
// steps.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  // Prisma 7 moved the connection URL out of this file and into
  // prisma.config.ts (for the CLI) and the driver adapter (for the runtime
  // client, see src/prisma/prisma.service.ts). `provider` still lives here.
  provider = "sqlite"
}

/// The four (for now) inventories, stored as data rather than a fixed enum —
/// see build plan Phase 4: a future factory can have a different set without
/// a schema change.
model InventoryType {
  id                String  @id @default(cuid())
  /// Stable machine key used by the frontend and seed data, e.g. "chemicals".
  key               String  @unique
  label             String
  singular          String
  description       String
  hasBatches        Boolean @default(false)
  hasExpiry         Boolean @default(false)
  isProductionInput Boolean @default(false)
  /// Whether items in this inventory carry a colour / size variant (e.g. tige).
  hasColor          Boolean @default(false)
  hasSize           Boolean @default(false)
  /// Whether items carry a free-text description (e.g. spare parts).
  hasDescription    Boolean @default(false)
  /// Whether items carry maintenance-oriented machine info (machine,
  /// compatibility, manufacturer, location, criticality) and their usages
  /// record maintenance context (reference, employee, notes). Used by spare
  /// parts.
  hasMachineInfo    Boolean @default(false)
  /// Whether items carry a gender variant — "M"/"F". Used by finished goods.
  hasGender         Boolean @default(false)
  /// Whether items carry a sale price (in DZD). Used by finished goods.
  hasPrice          Boolean @default(false)
  /// Whether movements distinguish production quality ("1er"/"2ème"/"rebut").
  /// Used by finished goods — the classified buckets reconcile against the
  /// computed quantity to surface unaccounted units.
  hasQuality        Boolean @default(false)
  defaultUnit       String
  sortOrder         Int     @default(0)

  items Item[]
}

model Item {
  id               String        @id @default(cuid())
  inventoryType    InventoryType @relation(fields: [inventoryTypeId], references: [id])
  inventoryTypeId  String
  name             String
  reference        String        @unique
  unit             String
  reorderThreshold Float
  /// Optional photo — a URL (http/https) or a data-URI (inline image).
  photoUrl         String?
  /// Optional variant attributes (relevant for e.g. tige des chaussures).
  color            String?
  size             String?
  /// Optional free-text description (relevant for e.g. spare parts).
  description      String?
  /// Maintenance-oriented attributes (relevant for spare parts; gated in the
  /// UI by InventoryType.hasMachineInfo).
  machine          String?
  compatibility    String?
  manufacturer     String?
  location         String?
  criticality      String?
  /// Optional gender variant "M"/"F" (relevant for e.g. produced footwear;
  /// gated in the UI by InventoryType.hasGender).
  gender           String?
  /// Optional sale price in DZD (gated in the UI by InventoryType.hasPrice).
  price            Float?
  /// Standard purchase cost per unit, in DZD. What a reception defaults to
  /// when nothing more precise is known, and the fallback the valuation uses
  /// for movements recorded before costs were tracked. The figure the
  /// valuation actually reports is the weighted average of what was really
  /// paid (see stock/stock-math.ts) — this column is only the starting point.
  unitCost         Float?
  archived         Boolean       @default(false)
  createdAt        DateTime      @default(now())

  batches            Batch[]
  movements          Movement[]
  supplierOrderLines SupplierOrderLine[]

  /// Batches where this item is the finished product being made.
  producedIn    ProductionBatch[]
  /// Lines where this item was consumed as a raw material.
  consumedIn    ProductionConsumption[]
  /// Purchase-order lines and customer-order lines naming this item.
  purchaseLines PurchaseOrderLine[]
  orderLines    OrderLine[]

  @@index([inventoryTypeId])
}

/// Only used by items whose inventory type has hasBatches = true (chemicals).
/// A batch's remaining quantity is never stored directly — it is always the
/// sum of its movements, computed on read (see stock/stock.service.ts).
model Batch {
  id           String    @id @default(cuid())
  item         Item      @relation(fields: [itemId], references: [id])
  itemId       String
  batchNumber  String
  receivedDate DateTime
  expiryDate   DateTime?

  movements  Movement[]
  /// Production lines that drew from this specific stock lot.
  consumedIn ProductionConsumption[]

  @@index([itemId])
}

/// The only place stock quantity comes from. An item's quantity is always
/// SUM(IN) - SUM(OUT) over its movements — never a column that gets edited
/// directly. This is deliberate (see build plan, "five calls that are cheap
/// today"): it is the only way to answer "how did we get to this number?".
model Movement {
  id             String    @id @default(cuid())
  item           Item      @relation(fields: [itemId], references: [id])
  itemId         String
  batch          Batch?    @relation(fields: [batchId], references: [id])
  batchId        String?
  /// "IN" | "OUT" — kept as a plain string (not a Prisma enum) so this schema
  /// is portable to SQLite and PostgreSQL without a provider-specific type.
  /// Validated at the API boundary (see stock/dto).
  direction      String
  quantity       Float
  date           DateTime
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  supplierId     String?
  /// Only set on "OUT" movements (e.g. "Production", "Casse", "Périmé").
  reason         String?
  /// Maintenance context recorded on OUT usages of spare parts
  /// (gated in the UI by InventoryType.hasMachineInfo).
  machine        String?
  maintenanceRef String?
  employee       String?
  notes          String?
  /// Production character classification for finished goods
  /// (gated by InventoryType.hasQuality): "1er", "2ème" or "rebut".
  /// Movements left untagged are exactly what the reconciliation flags as
  /// unaccounted units — stock whose presence no production record explains.
  quality        String?
  /// What one unit cost on THIS movement, in DZD. Set on IN movements (a
  /// reception, a purchase receipt, a supplier delivery) and on the IN
  /// movement that credits a production batch's output, where it carries the
  /// raw-material cost per finished unit. Also set on production OUT
  /// movements, so a consumption's cost is the cost the lot actually held.
  ///
  /// Stored per movement rather than only on the item because that is the
  /// only way to answer "where did this value come from?" — the item's
  /// average cost is derived from these rows, never the other way round.
  unitCost       Float?
  /// Where this movement came from: "MANUAL" | "SUPPLIER_ORDER" | "PURCHASE"
  /// | "PRODUCTION" | "SALE". Plain string, same portability reason as
  /// `direction`. Null on rows written before provenance was recorded.
  sourceType     String?
  /// The human-readable document behind it, e.g. "BC-2026-0007" or
  /// "LOT-2026-0012". Denormalised on purpose: the detail view must stay
  /// readable without joining four tables.
  sourceRef      String?
  createdAt      DateTime  @default(now())

  @@index([itemId])
  @@index([batchId])
}

model Supplier {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  notes        String?
  /// Free-text registration details (registre de commerce, NIF, NIS…). One
  /// field rather than four columns: the exact set differs by country, and
  /// nothing computes on them.
  registration String?
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())

  movements      Movement[]
  purchaseOrders PurchaseOrder[]
  supplierOrders SupplierOrder[]
}

/// A purchase order placed with a supplier. Stock only actually enters the
/// inventory when the order is received (see POST /supplier-orders/:id/receive,
/// which creates the IN movements and batch records). "regular inventory"
/// (tige, spare parts) has no expiry; chemicals orders carry per-line batch
/// info captured at receive time.
model SupplierOrder {
  id           String    @id @default(cuid())
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  supplierId   String
  orderDate    DateTime
  /// "open" | "received" — plain string, validated at the API boundary.
  status       String    @default("open")
  receivedDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  lines SupplierOrderLine[]

  @@index([supplierId])
}

model SupplierOrderLine {
  id              String        @id @default(cuid())
  order           SupplierOrder @relation(fields: [orderId], references: [id])
  orderId         String
  item            Item          @relation(fields: [itemId], references: [id])
  itemId          String
  quantityOrdered Float
  /// Agreed price per unit, in DZD. Optional: an order can be placed before
  /// the price is confirmed, in which case the reception falls back to the
  /// item's standard cost.
  unitCost        Float?
  /// Batch details captured when the order is received (chemicals only).
  batchNumber     String?
  expiryDate      DateTime?

  @@index([orderId])
}

/// A single production activity: one product, one machine, one shift.
///
/// This is the record that connects raw materials to finished output. It is
/// deliberately the *only* place production is recorded — the Production tab
/// no longer keeps anything in localStorage.
///
/// Note what is NOT stored here: the number of unknown/unaccounted units.
/// That is always `expectedQuantity - firstChoice - secondChoice - waste`,
/// computed on read (see production/production-math.ts), for exactly the same
/// reason stock quantity is never a column — a stored variance can drift away
/// from the numbers it claims to summarise, and the whole point of this table
/// is that the variance is trustworthy.
model ProductionBatch {
  id               String   @id @default(cuid())
  /// Human-readable batch id shown to the factory, e.g. "LOT-2026-0007".
  /// Generated by the service when not supplied.
  code             String   @unique
  date             DateTime
  /// The finished-goods Item being produced. There is no separate product
  /// catalogue yet (build plan Phase 5) — see PROJECT_CONTEXT.md §9.
  product          Item     @relation(fields: [productItemId], references: [id])
  productItemId    String
  machine          String
  supervisor       String?
  operator         String?
  shift            String
  /// "HH:MM", plain strings — a batch's clock times are operator-entered and
  /// never used for arithmetic, so a full DateTime would only add timezone bugs.
  startTime        String?
  endTime          String?
  /// What the machine counter announced. The denominator of every rate.
  expectedQuantity Float
  firstChoice      Float    @default(0)
  secondChoice     Float    @default(0)
  waste            Float    @default(0)
  /// Whether the output figures above have been declared yet. Until they have,
  /// the variance is meaningless and is reported as null rather than as
  /// "everything is unknown".
  outputDeclared   Boolean  @default(false)
  /// One of the PRODUCTION_STATUSES strings (see production-math.ts). Plain
  /// string, not a Prisma enum, for the same portability reason as
  /// Movement.direction.
  status           String   @default("PLANNED")
  /// What the investigation into a non-zero variance concluded. Neutral,
  /// operational language — this field is not an accusation form.
  varianceNote     String?
  notes            String?
  /// The IN movement that credited first+second choice to finished-goods stock.
  outputMovementId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  consumptions ProductionConsumption[]

  @@index([productItemId])
  @@index([date])
  @@index([status])
}

/// One raw material line consumed by one production batch: which item, which
/// stock lot (for chemicals), how much. Answers "what went into this batch".
model ProductionConsumption {
  id                String          @id @default(cuid())
  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id], onDelete: Cascade)
  productionBatchId String
  item              Item            @relation(fields: [itemId], references: [id])
  itemId            String
  /// The stock lot drawn from — only set for items whose inventory type has
  /// batches (chemicals). FEFO/FIFO order is *recommended* by the UI, not
  /// enforced here: a factory sometimes has a real reason to break the order.
  stockBatch        Batch?          @relation(fields: [stockBatchId], references: [id])
  stockBatchId      String?
  quantity          Float
  /// What one unit of this material cost when it was drawn, in DZD — a
  /// SNAPSHOT, deliberately, exactly like Order.shipTo*: re-pricing a lot's
  /// materials months later because stock got cheaper would rewrite what the
  /// batch actually cost to make. Null when the material had no known cost.
  unitCost          Float?
  /// The OUT movement this line created, so the ledger and the batch record
  /// can always be traced to each other. Plain id, not a relation: Movement is
  /// an append-only ledger and nothing should be able to cascade into it.
  movementId        String?
  createdAt         DateTime        @default(now())

  @@index([productionBatchId])
  @@index([itemId])
}

/// A job title, stored as data rather than written into the code — the build
/// plan's Phase 2 is explicit about this: "the next factory will have
/// different job titles". A guard never checks for the *name* "gerant"; it
/// checks whether the user's role carries a permission string.
model Role {
  id          String   @id @default(cuid())
  /// Stable machine key, e.g. "gerant". Safe to reference from seed data.
  key         String   @unique
  label       String
  description String
  /// Permission strings this role grants, e.g. "stock:write". Stored as one
  /// comma-separated string so the schema stays portable to both SQLite and
  /// PostgreSQL (SQLite has no array type). Read/written only through
  /// auth/permissions.ts — never parsed by hand elsewhere.
  permissions String
  /// A role the gérant cannot delete or strip of access, so the factory can
  /// never lock itself out of its own system.
  isProtected Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  users User[]
}

model User {
  id           String    @id @default(cuid())
  /// What they type to log in. Lowercased on write so "Karim" and "karim"
  /// can't become two accounts.
  login        String    @unique
  fullName     String
  /// bcrypt hash. The plain password is never stored, logged or returned —
  /// see auth/auth.service.ts. Non-negotiable, per the build plan.
  passwordHash String
  role         Role      @relation(fields: [roleId], references: [id])
  roleId       String
  /// Deactivated rather than deleted: workers leave, but their audit trail
  /// and their movements must stay attributable. A deactivated user cannot
  /// log in and their existing tokens stop working on the next request.
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditEntries AuditEntry[]

  @@index([roleId])
}

/// Who did what, and when. The build plan calls this "the only thing that
/// settles it when the numbers disagree", so it records the changed values,
/// not just the action.
///
/// Append-only in spirit, like Movement: nothing in the app updates or
/// deletes a row here. The user relation is kept (rather than a bare id) so a
/// deactivated employee's history still shows their name.
model AuditEntry {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  /// Null only for actions taken before anyone was logged in (a failed login).
  userId    String?
  /// Denormalised so the log stays readable even if a user is ever removed.
  userLogin String
  /// "CREATE" | "UPDATE" | "DELETE" | "LOGIN" | "LOGIN_FAILED"
  action    String
  /// What kind of thing was touched, e.g. "item", "production-batch".
  entity    String
  entityId  String?
  /// JSON: the changed fields only, as {field: {from, to}} for an update, or
  /// the created/deleted record for a create/delete. Passwords are stripped
  /// before anything reaches here (see audit.interceptor.ts).
  changes   String?
  method    String
  path      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ===========================================================================
// PURCHASING  —  Supplier → PurchaseOrder → Receipt → Inventory
// ===========================================================================

/// A purchase order sent to a supplier. The commitment side of buying: it
/// records what was ORDERED. What actually arrived is a Receipt, and stock
/// only moves when a receipt is posted — never when a PO is created.
///
/// Received quantities are never stored on the line. They are always summed
/// from ReceiptLine, the same rule as stock quantity and production variance:
/// a stored "received so far" can drift from the receipts it claims to total.
model PurchaseOrder {
  id           String    @id @default(cuid())
  /// Human-readable, unique, generated per calendar year: "BC-2026-0007".
  /// "BC" = bon de commande.
  code         String    @unique
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  supplierId   String
  date         DateTime
  expectedDate DateTime?
  /// DRAFT | SUBMITTED | APPROVED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  /// Plain string, same portability reason as Movement.direction.
  status       String    @default("DRAFT")
  /// Order-level money, in DZD. Line amounts live on the lines.
  shipping     Float     @default(0)
  /// FIXED or PERCENT — see discount's own comment.
  discountType String    @default("FIXED")
  /// What the buyer typed: a DZD amount when discountType is FIXED, or a
  /// fraction (0.10 for 10 %) when it's PERCENT — same "type the rate, never
  /// the amount" reasoning as taxRate below. The DZD figure this produces is
  /// always computed (see purchasing/purchasing-math.ts's poTotals), never
  /// stored, so it can't drift when a line or the shipping changes.
  discount     Float     @default(0)
  /// The tax rate as a fraction (0.19 for 19 %) — what the buyer actually
  /// types. The DZD amount is always computed from it (see
  /// purchasing/purchasing-math.ts), never stored: a flat figure would drift
  /// the moment a line, the shipping or the discount changed.
  taxRate      Float     @default(0)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines    PurchaseOrderLine[]
  receipts Receipt[]

  @@index([supplierId])
  @@index([status])
  @@index([date])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  item            Item          @relation(fields: [itemId], references: [id])
  itemId          String
  quantity        Float
  unitCost        Float

  receiptLines ReceiptLine[]

  @@index([purchaseOrderId])
  @@index([itemId])
}

/// One delivery against a purchase order. Posting a receipt is what actually
/// moves stock — it creates the IN movements (and, for chemicals, the Batch
/// carrying the lot number and expiry date).
model Receipt {
  id              String        @id @default(cuid())
  code            String        @unique
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  date            DateTime
  /// Supplier's own delivery-note number, for matching paperwork.
  deliveryNote    String?
  notes           String?
  createdAt       DateTime      @default(now())

  lines ReceiptLine[]

  @@index([purchaseOrderId])
}

model ReceiptLine {
  id                  String            @id @default(cuid())
  receipt             Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptId           String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  purchaseOrderLineId String
  quantity            Float
  /// The Movement this line created. Plain id, not a relation: Movement is an
  /// append-only ledger and nothing may cascade into it.
  movementId          String?
  /// The Batch created for a chemical delivery, carrying lot + expiry.
  batchId             String?

  @@index([receiptId])
  @@index([purchaseOrderLineId])
}

// ===========================================================================
// SALES  —  Customer → Order → Shipment → Inventory
// ===========================================================================

model Customer {
  id         String   @id @default(cuid())
  code       String   @unique
  fullName   String
  email      String?
  phone      String?
  address    String?
  city       String?
  province   String?
  country    String?
  postalCode String?
  notes      String?
  /// Archived rather than deleted: a customer with orders must stay
  /// attributable, same rule as items and suppliers.
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[]
}

/// A customer order. Money is stored per line and per order; every TOTAL is
/// computed on read (orders-math.ts) rather than stored, so a subtotal can
/// never disagree with the lines it claims to sum.
model Order {
  id             String   @id @default(cuid())
  /// "CMD-2026-0007", unique, generated per calendar year.
  code           String   @unique
  customer       Customer @relation(fields: [customerId], references: [id])
  customerId     String
  date           DateTime
  /// PENDING | SHIPPED | CANCELLED
  shipmentStatus String   @default("PENDING")
  /// PENDING | PAID | CANCELLED
  paymentStatus  String   @default("PENDING")
  shipping       Float    @default(0)
  /// FIXED or PERCENT — see discount's own comment.
  discountType   String   @default("FIXED")
  /// What the seller typed: a DZD amount when discountType is FIXED, or a
  /// fraction (0.10 for 10 %) when it's PERCENT — same "type the rate, never
  /// the amount" reasoning as taxRate below. The DZD figure this produces is
  /// always computed (see sales/sales-math.ts's orderTotals), never stored,
  /// so it can't drift when a line or the shipping changes.
  discount       Float    @default(0)
  /// The tax rate as a fraction (0.19 for 19 %) — what the seller actually
  /// types, same reasoning as PurchaseOrder.taxRate. The DZD amount is always
  /// computed from it (see sales/sales-math.ts's orderTotals), never stored,
  /// so it can't drift when a line, the shipping or the discount changes.
  taxRate        Float    @default(0)
  notes          String?

  /// The delivery address, SNAPSHOT from the customer when the order is
  /// created. Deliberately copied rather than joined: editing a customer's
  /// address must never silently rewrite where a past order was sent.
  shipToName       String?
  shipToPhone      String?
  shipToEmail      String?
  shipToAddress    String?
  shipToCity       String?
  shipToProvince   String?
  shipToCountry    String?
  shipToPostalCode String?

  /// Set when the order ships — the OUT movements are created then, not at
  /// order time, because an unshipped order hasn't left the building.
  shippedAt DateTime?
  /// Archived, not deleted — same rule as Customer.archived and
  /// Employee.archived. A shipped order has a stock trail that must stay
  /// attributable, so archiving (hide from the default list) is the escape
  /// hatch removeOrder() can't be for it. Any order can be archived,
  /// regardless of shipment/payment state — it only affects list visibility.
  archived   Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  lines   OrderLine[]
  returns OrderReturn[]

  @@index([customerId])
  @@index([shipmentStatus])
  @@index([paymentStatus])
  @@index([date])
  @@index([archived])
}

model OrderLine {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  item       Item    @relation(fields: [itemId], references: [id])
  itemId     String
  quantity   Float
  unitPrice  Float
  /// Per-line discount in DZD, on top of any order-level discount.
  discount   Float   @default(0)
  /// The OUT movement created when the order shipped. Plain id — see ReceiptLine.
  movementId String?

  returnLines OrderReturnLine[]

  @@index([orderId])
  @@index([itemId])
}

/// A return posted against a shipped order — the mirror of Receipt on the
/// purchasing side, and what actually restores finished-goods stock (see
/// sales.service.ts's returnOrder()).
///
/// Recorded separately from Order.paymentStatus on purpose: a cancelled
/// payment does not always mean the goods came back (the customer may simply
/// not have paid and kept them — that is bad debt, not a return), and goods
/// coming back does not always mean the payment is in dispute (a refund can
/// be issued cleanly). Conflating the two used to mean a "cancelled" order
/// stayed permanently short in the finished-goods count with no way back.
model OrderReturn {
  id      String   @id @default(cuid())
  /// "RET-2026-0007", unique, generated per calendar year.
  code    String   @unique
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String
  date    DateTime
  /// Why the goods came back, e.g. "ne convient pas au client".
  reason    String?
  notes     String?
  createdAt DateTime @default(now())

  lines OrderReturnLine[]

  @@index([orderId])
}

model OrderReturnLine {
  id          String      @id @default(cuid())
  return      OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  returnId    String
  orderLine   OrderLine   @relation(fields: [orderLineId], references: [id])
  orderLineId String
  quantity    Float
  /// The IN movement this line created, restoring finished-goods stock.
  /// Plain id, not a relation — Movement is an append-only ledger and
  /// nothing may cascade into it.
  movementId String?

  @@index([returnId])
  @@index([orderLineId])
}

// ===========================================================================
// HR  —  Employees, time worked, absences
// ===========================================================================

/// A factory worker. Deactivated by archiving rather than deleted — someone
/// who leaves still has time entries, absences and (once payroll exists)
/// pay history that must stay attributable, the same reasoning as
/// Supplier.archived and User.active.
model Employee {
  id                    String    @id @default(cuid())
  fullName              String
  phone                 String?
  address               String?
  position              String
  hireDate              DateTime
  birthDate             DateTime?
  /// Numéro d'identification nationale — the Algerian national ID number,
  /// used across administrative filings. Optional: a factory may not have
  /// collected it for every worker yet.
  nin                   String?
  /// CNAS affiliation number (Caisse Nationale des Assurances Sociales) —
  /// the social-security registration behind sick leave, family allowance
  /// and retirement declarations.
  cnasNumber            String?
  /// "CDI" | "CDD" — plain string, same portability reason as
  /// Movement.direction. A CDD is a fixed-term contract and carries an end
  /// date; a CDI does not.
  contractType          String    @default("CDI")
  /// Only meaningful when contractType is "CDD".
  contractEndDate       DateTime?
  /// "CELIBATAIRE" | "MARIE" | "DIVORCE" | "VEUF" — situation familiale.
  /// Feeds the CNAS family allowance (allocations familiales), which is
  /// paid per dependent child, not the IRG (the 2022 reform removed the
  /// family deduction from the income-tax computation itself).
  maritalStatus         String?
  dependentChildren     Int       @default(0)
  /// Gross monthly base salary, in DZD — bonuses are not modelled yet.
  /// Overtime is tracked separately (OvertimeEntry). CNAS and IRG are always
  /// computed from it on read (see hr/payroll-math.ts); nothing derived is
  /// stored, same rule as stock quantity and PO totals.
  salary                Float
  /// Expected worked hours per calendar day, used by the monthly summary's
  /// "heures prévues" column in place of a single factory-wide constant.
  /// Editable per employee (part-time, different shift lengths, …).
  expectedHoursPerDay   Float     @default(8)
  /// Relevé d'identité bancaire — where the salary is paid. Free text: the
  /// exact bank/agency/account breakdown differs by bank and nothing here
  /// computes on it.
  bankRib               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  archived              Boolean   @default(false)
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  timeEntries    TimeEntry[]
  absences       Absence[]
  overtimeEntries OvertimeEntry[]

  @@index([archived])
}

/// A day's worked hours. Kept as a ledger, not a monthly total, so a future
/// fingerprint clock can write into this same table (source: "device")
/// without reshaping anything — see build plan Phase 8.
model TimeEntry {
  id          String   @id @default(cuid())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  date        DateTime
  hoursWorked Float
  /// "manual" | "device".
  source      String   @default("manual")
  createdAt   DateTime @default(now())

  @@index([employeeId])
  @@index([date])
}

/// One period an employee did not work. "INJUSTIFIEE" is deliberately not
/// called a disciplinary record — this table states what happened, not a
/// judgement about it.
model Absence {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  /// "CONGE" | "MALADIE" | "INJUSTIFIEE".
  type       String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

/// Extra hours worked beyond the expected schedule, declared over a date
/// range (not necessarily a single day) with an optional reason — the same
/// shape as Absence, so the monthly summary can treat both as "click a cell,
/// see why" ledgers.
model OvertimeEntry {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  startDate  DateTime
  endDate    DateTime
  hours      Float
  reason     String?
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

/// A general factory operating cost (rent, electricity, indirect wages,
/// maintenance…) — free-form label like the margin calculator's cost lines,
/// but persisted and dated so it accumulates into a monthly ledger instead of
/// resetting every time the calculator is used.
model FactoryCost {
  id        String   @id @default(cuid())
  label     String
  amount    Float
  date      DateTime
  createdAt DateTime @default(now())

  @@index([date])
}

/// One Zakat calculation, snapshotted at the moment it was made — a
/// historical record, not a live figure, so a past year's Zakat never
/// silently changes when this year's stock or receivables move (see the
/// build's own rule: "a payslip must never recompute itself"). Only the raw
/// inputs are stored; everything derived (totals, nisab comparison, zakat
/// due, the Hijri due date) is computed on read from them — see
/// zakat/zakat-math.ts, same "never store what can drift" rule as payroll
/// and order totals.
model ZakatCalculation {
  id      String   @id @default(cuid())
  /// The date this calculation is as-of — the hawl's anchor date.
  calculationDate DateTime
  /// "LUNAR" (default, the standard hawl) | "SOLAR" (alternative, Gregorian year).
  methodology     String   @default("LUNAR")
  /// DZD per gram, typed in by the gérant — nisab is 85 g of gold at this price.
  goldPricePerGram Float

  // Zakatable assets — cash/bank and "other" are typed in (this ERP has no
  // treasury ledger); finished goods, raw materials and receivables are
  // normally auto-filled from Stock and Ventes at calculation time, but
  // stored as plain numbers either way so a past record never drifts.
  cash               Float @default(0)
  bank               Float @default(0)
  finishedGoodsValue Float @default(0)
  rawMaterialsValue  Float @default(0)
  receivablesValue   Float @default(0)
  otherAssets        Float @default(0)

  /// Short-term liabilities eligible for deduction (e.g. amounts owed to
  /// suppliers) — typed in; this ERP does not model accounts payable.
  deductions Float @default(0)
  /// A fraction, e.g. 0.025 for 2.5 % — typed, never hardcoded, in case a
  /// different school/ruling applies a different rate.
  zakatRate  Float @default(0.025)

  amountPaid  Float     @default(0)
  paymentDate DateTime?
  notes       String?

  /// The one calculation, if any, explicitly exported to the ZAKATI
  /// dashboard — a deliberate action (see zakat.service.ts pinCalculation),
  /// never automatic, so saving a calculation into the history never
  /// silently changes what the automatic dashboard shows. At most one row
  /// has this true at a time.
  pinned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([calculationDate])
  @@index([pinned])
}

/// A fetched (or manually typed) gold price, DZD per gram — append-only, so
/// "what did we use last time" is always answerable. The most recent row is
/// "current"; zakat.service.ts refetches automatically once the newest row
/// is more than a day old.
model GoldPriceSnapshot {
  id           String   @id @default(cuid())
  pricePerGram Float
  /// "goldrate24.com" | "manuel".
  source       String
  fetchedAt    DateTime @default(now())

  @@index([fetchedAt])
}
